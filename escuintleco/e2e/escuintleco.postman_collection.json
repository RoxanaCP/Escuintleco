{
  "info": {
    "name": "Escuintleco E2E",
    "description": "Pruebas end-to-end de API: login, crear producto, listar, eliminar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "productoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve token', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token', json.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Crear Producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Producto creado con id', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.id).to.not.be.undefined;",
              "    pm.collectionVariables.set('productoId', json.id);",
              "});",
              "pm.test('Codigo correcto', function () {",
              "    pm.expect(pm.response.json().codigo).to.eql('E2E001');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"E2E001\",\n  \"nombre\": \"Producto E2E\",\n  \"precioCompra\": 5.00,\n  \"precioVenta\": 10.00,\n  \"stock\": 50,\n  \"stockMinimo\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "3. Listar Productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve una lista', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "pm.test('Contiene el producto creado', function () {",
              "    var lista = pm.response.json();",
              "    var encontrado = lista.some(function (p) { return p.codigo === 'E2E001'; });",
              "    pm.expect(encontrado).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "4. Eliminar Producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "{{productoId}}"]
        }
      }
    }
  ]
}
